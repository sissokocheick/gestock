# Copier ce fichier en ".env" puis remplacer les valeurs
# PostgreSQL 18 local (celui utilisé par GSV) : port 5432
#   postgres://gsv_app:VOTRE_MOT_DE_PASSE@localhost:5432/gestion_stock
# (l'ancien PostgreSQL 13 éventuellement installé utilise le port 5433)
DATABASE_URL=postgres://gsv_app:VOTRE_MOT_DE_PASSE@localhost:5432/gestion_stock
JWT_SECRET=changez-moi-en-un-secret-long-et-aleatoire
PORT=4000
